# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ironforge-super-secret-jwt-key-2026-production"
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"

# Payment Gateways (Stripe + Local Gateway Adapters)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_ironforge_mock"
STRIPE_SECRET_KEY="sk_test_ironforge_mock"
BKASH_APP_KEY="bkash_sandbox_key"
SSLCOMMERZ_STORE_ID="ironforge_ssl_sandbox"

# Email / Notifications
RESEND_API_KEY="re_ironforge_sandbox_key"

# Analytics & Brand
NEXT_PUBLIC_ANALYTICS_PROVIDER="plausible"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
